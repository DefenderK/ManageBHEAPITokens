# Copy to .env beside Remove-BHEStaleAPITokens.ps1, then uncomment and fill in values.
# This file stores plaintext credentials. Restrict access and never commit real secrets.
# Precedence per setting: explicit parameter > .env > process environment.
# Values are literal. Optional matching quotes are removed. Use whole-line comments only.

# Request-signing authentication (recommended):
# BHE_URL=https://your-tenant.bloodhoundenterprise.io
# For local Docker, use your published port, e.g. BHE_URL=http://127.0.0.1:8080
# BHE_TOKEN_ID=your-token-id
# BHE_TOKEN_KEY=your-token-key
# BHE_BEARER_TOKEN=

# For bearer authentication instead, set BHE_URL plus these three assignments:
# BHE_TOKEN_ID=
# BHE_TOKEN_KEY=
# BHE_BEARER_TOKEN=your-existing-bearer-token
